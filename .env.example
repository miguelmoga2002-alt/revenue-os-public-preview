POSTGRES_PASSWORD=CHANGE_THIS_TO_A_RANDOM_SECRET
POSTGRES_APP_PASSWORD=CHANGE_THIS_TO_A_DIFFERENT_RANDOM_SECRET
# Only for local API tooling, never give owner URL to the API container.
# Must be a private Fernet key, generated securely and kept out of Git.
REVENUE_OS_MFA_ENCRYPTION_KEY=CHANGE_THIS_TO_PRIVATE_FERNET_KEY
REVENUE_OS_REQUIRE_ADMIN_MFA=1
# Pipedrive API v2 sandbox-only token connector. Disabled until explicitly enabled.
# Do not put real access tokens in Git or in this example file.
REVENUE_OS_ENABLE_PIPEDRIVE_SYNC=0
# Map each exact Revenue OS tenant ID to a fixed Pipedrive subdomain and an
# environment VARIABLE NAME (never the token value).
REVENUE_OS_PIPEDRIVE_CONNECTIONS_JSON={}
# Example ONLY: provision REVENUE_OS_PD_TOKEN_<TENANT> via secrets manager.

# Multi-CRM OAuth sandbox (disabled by default, NEVER commit real credentials).
REVENUE_OS_ENABLE_CRM_OAUTH=0
# Generate a separate Fernet key and load from a secret manager.
REVENUE_OS_OAUTH_ENCRYPTION_KEY=
# Exact HTTPS URL matching each provider developer app registration.
REVENUE_OS_OAUTH_CALLBACK_URL=
REVENUE_OS_HUBSPOT_CLIENT_ID=
REVENUE_OS_HUBSPOT_CLIENT_SECRET=
REVENUE_OS_SALESFORCE_CLIENT_ID=
REVENUE_OS_SALESFORCE_CLIENT_SECRET=
REVENUE_OS_PIPEDRIVE_CLIENT_ID=
REVENUE_OS_PIPEDRIVE_CLIENT_SECRET=

# Browser origin behind a trusted TLS reverse proxy; exact scheme+hostname+port.
# Must be set for production HTTPS, e.g. https://app.example.invalid
REVENUE_OS_PUBLIC_ORIGIN=

# When set to production, backend refuses to start without HTTPS origin,
# Postgres restricted runtime role, mandatory admin MFA and encryption keys.
REVENUE_OS_ENV=development
